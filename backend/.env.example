# ─── Server ────────────────────────────────────────────────
PORT=8080

# ─── Database (Azure PostgreSQL Flexible Server) ────────────
DB_HOST=<your-server-name>.postgres.database.azure.com
DB_PORT=5432
DB_NAME=contactsdb
DB_USER=<your-admin-username>
DB_PASSWORD=<your-password>

# ─── CORS ───────────────────────────────────────────────────
# Set this to your Azure Static Web App URL after deploying the frontend
FRONTEND_URL=https://<your-static-web-app>.azurestaticapps.net
